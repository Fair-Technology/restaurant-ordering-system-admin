# Vite build-time variables. Copy to `.env.local` and fill in (`.env.local` is gitignored).
# The dev values live in this repo's `dev` environment Actions variables
# (Settings -> Environments -> dev). They are compile-time values, public in any
# built bundle, so they are not secrets — but do not commit your `.env.local`.
#
# Without the VITE_MSAL_* values the app throws during msalInstance.initialize()
# and renders nothing.

VITE_API_BASE_URL=
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=
VITE_MSAL_TENANT_NAME=
VITE_MSAL_API_SCOPE=
VITE_SHOP_BASE_URL=
VITE_STRIPE_PUBLISHABLE_KEY=
