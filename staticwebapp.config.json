{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.css",
      "/*.js",
      "/*.mjs",
      "/*.png",
      "/*.jpg",
      "/*.svg",
      "/*.ico",
      "/*.txt",
      "/*.woff",
      "/*.woff2",
      "/*.webmanifest"
    ]
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
